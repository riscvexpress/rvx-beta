COPY_DIR_LIST := synthesizer imp_class hwlib_special platform_repo

copy_from_etri:
	@$(foreach dir,$(COPY_DIR_LIST), \
		rm -rf ./$(dir); \
		cp -r ~/rvx_etri/$(dir) ./$(dir); \
    git add -A ./$(dir); )

# replace each platform in ./platform_test with the one in rvx_etri, if it exists there
update_platform_test:
	@for dir in ./platform_test/*/; do \
		[ -d $$dir ] || continue; \
		name=$$(basename $$dir); \
		[ -d ~/rvx_etri/platform_test/$$name ] || continue; \
		echo "update platform_test/$$name"; \
		rm -rf ./platform_test/$$name; \
		cp -r ~/rvx_etri/platform_test/$$name ./platform_test/$$name; \
    git add -A ./platform_test/$$name; \
	done

update_alpha: update_commit copy_from_etri update_platform_test

.PHONY: update_commit copy_from_etri update_platform_test update_alpha
